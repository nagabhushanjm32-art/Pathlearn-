generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  aiConversations AIConversation[]
  bookmarks       Bookmark[]
  certificates    Certificate[]
  mockInterviews  MockInterview[]
  profile         Profile?
  quizAttempts    QuizAttempt[]
  roadmaps        Roadmap[]
  skillMastery    SkillMastery[]
  studyPlans      StudyPlan[]
  userProgress          UserProgress[]
  stepProgress          UserStepProgress[]
  careerProfile         CareerProfile?
  resumeAnalyses        ResumeAnalysis[]
  userSkills            UserSkill[]
  skillGaps             SkillGap[]
  careerRecommendations CareerRecommendation[]

  @@index([email])
}

model Profile {
  id                  String     @id @default(cuid())
  userId              String     @unique
  avatarUrl           String?
  targetRole          String?
  level               Level?
  goal                Goal?
  studyTimePerDay     StudyTime?
  onboardingCompleted Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Domain {
  id             String          @id @default(cuid())
  name           String          @unique
  slug           String          @unique
  description    String
  icon           String?
  difficulty     Level
  estimatedDays  Int
  skillTags      String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  certificates   Certificate[]
  mockInterviews MockInterview[]
  roadmaps       Roadmap[]
  studyPlans     StudyPlan[]
  userProgress   UserProgress[]

  @@index([slug])
}

model Roadmap {
  id        String        @id @default(cuid())
  userId    String
  domainId  String
  progress  Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  domain    Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     RoadmapStep[]

  @@unique([userId, domainId])
  @@index([userId])
}

model RoadmapStep {
  id                 String     @id @default(cuid())
  roadmapId          String
  order              Int
  title              String
  description        String
  difficulty         Level
  estimatedMinutes   Int
  prerequisites      String[]
  learningObjectives String[]
  skillsGained       String[]
  interviewRelevance String?
  isLocked           Boolean    @default(true)
  isCompleted        Boolean    @default(false)
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  bookmarks          Bookmark[]
  notes              Note[]
  quiz               Quiz?
  resources          Resource[]
  roadmap            Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  videos             Video[]
  stepProgress       UserStepProgress[]

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model Resource {
  id            String      @id @default(cuid())
  roadmapStepId String
  type          String
  title         String
  url           String
  createdAt     DateTime    @default(now())
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@index([roadmapStepId])
}

model Video {
  id            String      @id @default(cuid())
  roadmapStepId String
  youtubeId     String
  title         String
  channel       String
  thumbnailUrl  String
  durationSecs  Int
  url           String
  createdAt     DateTime    @default(now())
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@index([roadmapStepId])
}

model Note {
  id            String      @id @default(cuid())
  roadmapStepId String
  content       Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@index([roadmapStepId])
}

model Bookmark {
  id            String      @id @default(cuid())
  userId        String
  roadmapStepId String
  createdAt     DateTime    @default(now())
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapStepId])
}

model Quiz {
  id            String         @id @default(cuid())
  roadmapStepId String         @unique
  createdAt     DateTime       @default(now())
  roadmapStep   RoadmapStep    @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  attempts      QuizAttempt[]
  questions     QuizQuestion[]
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  question     String
  options      String[]
  correctIndex Int
  explanation  String
  difficulty   Level
  createdAt    DateTime     @default(now())
  answers      QuizAnswer[]
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  totalCount  Int
  completedAt DateTime     @default(now())
  answers     QuizAnswer[]
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id             String       @id @default(cuid())
  quizAttemptId  String
  quizQuestionId String
  selectedIndex  Int
  isCorrect      Boolean
  quizAttempt    QuizAttempt  @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)

  @@index([quizAttemptId])
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String
  domainId   String
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId])
}

model SkillMastery {
  id        String   @id @default(cuid())
  userId    String
  skillName String
  mastery   Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

model StudyPlan {
  id           String      @id @default(cuid())
  userId       String
  domainId     String
  hoursPerWeek Float
  targetDate   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  domain       Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        StudyTask[]

  @@index([userId])
}

model StudyTask {
  id           String    @id @default(cuid())
  studyPlanId  String
  dayOfWeek    Int
  title        String
  durationMins Int
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  studyPlan    StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId])
}

model MockInterview {
  id                  String              @id @default(cuid())
  userId              String
  domainId            String
  type                InterviewType       @default(TECHNICAL)
  difficulty          Level               @default(INTERMEDIATE)
  status              String              @default("IN_PROGRESS")
  totalQuestions      Int                 @default(0)
  currentQuestion     Int                 @default(1)
  overallScore        Int?
  technicalScore      Int?
  problemSolvingScore Int?
  communicationScore  Int?
  practicalScore      Int?
  conceptualScore     Int?
  readinessLevel      String?
  strongAreas         String[]
  weakAreas           String[]
  recommendation      String?
  recommendedTopics   String[]
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  questions           InterviewQuestion[]
  domain              Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domainId])
}

model InterviewQuestion {
  id              String           @id @default(cuid())
  mockInterviewId String
  order           Int
  question        String
  topic           String?
  difficulty      String?
  questionType    String?
  answer          String?
  score           Int?
  correctness     Int?
  technicalDepth  Int?
  clarity         Int?
  knowledgeLevel  String?
  strengths       String[]
  weaknesses      String[]
  missingConcepts String[]
  feedback        String?
  createdAt       DateTime         @default(now())
  answerRelation  InterviewAnswer?
  mockInterview   MockInterview    @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)

  @@unique([mockInterviewId, order])
  @@index([mockInterviewId])
}

model InterviewAnswer {
  id                  String            @id @default(cuid())
  interviewQuestionId String            @unique
  answerText          String
  score               Int?
  whatWasGood         String?
  whatWasMissing      String?
  idealDirection      String?
  improvementTip      String?
  createdAt           DateTime          @default(now())
  interviewQuestion   InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String                    @id @default(cuid())
  certificateId   String                    @unique
  certificateCode String?                   @unique
  userId          String
  domainId        String
  status          String                    @default("ACTIVE")
  score           Int
  roadmapScore    Int?                      @default(100)
  quizScore       Int?
  interviewScore  Int?
  pdfUrl          String?
  verificationUrl String?
  issuedAt        DateTime                  @default(now())
  revoked         Boolean                   @default(false)
  revokedAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  domain          Domain                    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications   CertificateVerification[]

  @@unique([userId, domainId])
  @@index([certificateId])
  @@index([certificateCode])
}

model CertificateVerification {
  id            String      @id @default(cuid())
  certificateId String
  verifiedAt    DateTime    @default(now())
  ipHash        String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId], onDelete: Cascade)

  @@index([certificateId])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  domainId  String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserStepProgress {
  id             String      @id @default(cuid())
  userId         String
  stepId         String
  videoProgress  Float       @default(0)
  videoStarted   Boolean     @default(false)
  videoCompleted Boolean     @default(false)
  quizCompleted  Boolean     @default(false)
  quizScore      Int?
  stepCompleted  Boolean     @default(false)
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step           RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([stepId])
}

enum Role {
  USER
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Goal {
  LEARN_FUNDAMENTALS
  INTERVIEW_PREP
  BUILD_PROJECTS
  JOB_READY
}

enum StudyTime {
  THIRTY_MIN
  ONE_HOUR
  TWO_HOURS
  THREE_PLUS_HOURS
}

enum InterviewType {
  TECHNICAL
  HR
  SCENARIO_BASED
  MIXED
}

model CareerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetRole     String   @default("AI Engineer")
  readinessScore Int      @default(0)
  breakdownJson  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id             String   @id @default(cuid())
  userId         String
  fileName       String
  fileSize       Int
  fileType       String
  filePath       String?
  parsedData     Json
  aiAnalysis     Json
  resumeScore    Int      @default(75)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  name       String
  category   String   @default("TECHNICAL")
  level      String   @default("INTERMEDIATE")
  confidence Float    @default(0.8)
  source     String   @default("RESUME")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model SkillGap {
  id                 String   @id @default(cuid())
  userId             String
  targetRole         String
  skillName          String
  currentLevel       String   @default("Needs Improvement")
  requiredLevel      String   @default("Intermediate")
  matchPercentage    Int      @default(40)
  gapScore           Int      @default(60)
  status             String   @default("NEEDS_IMPROVEMENT")
  whyItMatters       String?
  recommendedTopics  String[]
  estimatedEffort    String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetRole])
}

model CareerRecommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  priority    String   @default("MEDIUM")
  meta        Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
