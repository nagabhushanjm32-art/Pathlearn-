# Environment Variables Template for PathLearn
# Copy to server/.env and client/.env as appropriate

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Authentication (JWT & HTTP-Only Cookies)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api

# AI Services (Phases 5-8)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API (Phase 6)
YOUTUBE_API_KEY=your_youtube_api_key_here
